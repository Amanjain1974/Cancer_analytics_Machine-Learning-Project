# Django Environment Variables Configuration
# Copy this file to .env and set your production values

# Secret Key (Generate a strong random string for production)
SECRET_KEY=django-insecure-cancer-ai-risk-intelligence-key-change-in-prod

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of hostnames or domains)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# CSRF Trusted Origins (Comma-separated HTTPS origins for Django 4+)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com,https://*.vercel.app

# Optional Database URL (PostgreSQL/MySQL). If unset, defaults to local SQLite (db.sqlite3)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
